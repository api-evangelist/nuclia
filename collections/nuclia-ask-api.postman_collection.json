  "item": [
    {
      "id": "e8008ec1-4a8a-4ef7-97ae-138ecbd46ee4",
      "name": "Ask",
      "description": {
        "content": "Generative RAG answers, chat and summarization grounded in a Knowledge Box.",
        "type": "text/plain"
